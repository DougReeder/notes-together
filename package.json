{
  "name": "notes-together",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "vitest",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal public/generated-icons/NotesTogether-Icon.svg",
    "build": "vite build",
    "betatest": "surge dist https://notes-together.surge.sh/; true",
    "prebuild": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0 && npm ci",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "rsync -v --rsh='ssh -p 2222 -i ~/.ssh/id_passwordless' --archive --delete --prune-empty-dirs --human-readable --exclude '.DS_Store' ~/git/notes-together/dist/* composed@hominidsoftware.com:/var/www/notestogether/",
    "deploy-scp": "scp -p -r -o PreferredAuthentications=publickey,password ~/git/notes-together/dist/* root@hominidsoftware.com:/var/www/notestogether/"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": "11",
      "onFail": "warn"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@fontsource/roboto": "^4.5.3",
    "@mui/icons-material": "^5.14.16",
    "@mui/material": "^5.14.17",
    "escape-html": "^1.0.3",
    "is-hotkey": "^0.2.0",
    "mdast-util-from-markdown": "^1.3.0",
    "mdast-util-gfm-strikethrough": "^1.0.3",
    "mdast-util-gfm-table": "^1.0.7",
    "mdast-util-gfm-task-list-item": "^1.0.2",
    "micromark-extension-gfm-strikethrough": "^1.0.5",
    "micromark-extension-gfm-table": "^1.0.5",
    "micromark-extension-gfm-task-list-item": "^1.0.4",
    "notistack": "^3.0.1",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.11",
    "react-router-dom": "^6.16.0",
    "react-transition-group": "^4.4.5",
    "remotestorage-widget": "github:remotestorage/remotestorage-widget#5f80dd41542b02c1113d2b9c3d37df7b4afca4a0",
    "remotestoragejs": "github:remotestorage/remotestorage.js#6351a8b904905289a4e4145031f8324567461e28",
    "slate": "0.123.0",
    "slate-history": "^0.115.0",
    "slate-hyperscript": "^0.115.0",
    "slate-react": "0.123.0",
    "tesseract.js": "^5.1.1",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.28",
    "@vite-pwa/assets-generator": "^0.2.6",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-vitest": "^0.3.22",
    "eslint-plugin-vitest-globals": "^1.4.0",
    "fake-indexeddb": "^4.0.2",
    "jsdom": "^26.1.0",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0"
  }
}
